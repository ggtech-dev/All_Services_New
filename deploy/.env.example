# All Services — production settings. Copy to deploy/.env and fill in. NEVER commit deploy/.env.

# Database (the PostgreSQL container is created with these)
PGDATABASE=all_services
PGUSER=all_services_user
PGPASSWORD=change_me_to_a_long_random_password
DB_SCHEMA=all_services

# Login tokens: a long random string (e.g. run: openssl rand -hex 48)
JWT_SECRET=change_me_to_a_long_random_string

# Email codes (sign-up, email login, forgot password). Required in production.
# Gmail: smtp.gmail.com, port 587, your Gmail address, a Gmail App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=All Services <no-reply@allservicesggtech.com>

# Mobile OTP SMS (2Factor.in). SMS_2FACTOR_TEMPLATE = your approved DLT template name (optional).
SMS_2FACTOR_API_KEY=
SMS_2FACTOR_TEMPLATE=

# Only used the first time db:setup creates the staff accounts (change them after the first login)
ADMIN_PASSWORD=
SUPERADMIN_PASSWORD=
