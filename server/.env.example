PORT=5000
PGHOST=localhost
PGPORT=5432
PGDATABASE=all_services
PGUSER=all_services_user
PGPASSWORD=change_me
DB_SCHEMA=all_services
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173

# Email (for login codes and password reset). Leave SMTP_HOST empty for TEST MODE:
# codes are printed in this terminal instead of being emailed.
# Free options: Brevo (smtp-relay.brevo.com, port 587), Gmail (smtp.gmail.com, 587, with an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=All Services <no-reply@yourdomain.in>


# Mobile number + OTP login: SMS by 2Factor.in. Empty = test mode (OTP shown on screen outside production).
SMS_2FACTOR_API_KEY=
# optional: your approved 2Factor OTP template name
SMS_2FACTOR_TEMPLATE=

# On a live server set NODE_ENV=production (test codes are then never shown on screen)
NODE_ENV=development

# Only used the first time "npm run db:setup" creates the staff accounts (change the passwords after first login)
ADMIN_PASSWORD=
SUPERADMIN_PASSWORD=
